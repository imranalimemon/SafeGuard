# ── Python/Backend Ignore ──
__pycache__/
*.py[cod]
*$py.class
*.db
*.sqlite
backend/safeguard.db
backend/.env
backend/screenshots/*
!backend/screenshots/.gitkeep
backend/temp/

# ── Node/Frontend Ignore ──
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── IDEs/OS Ignore ──
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.DS_Store
Thumbs.db
.env
